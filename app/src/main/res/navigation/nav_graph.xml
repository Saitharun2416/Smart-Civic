<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartcivicgovernance.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.smartcivicgovernance.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Citizen Flow -->
    <fragment
        android:id="@+id/citizenHomeFragment"
        android:name="com.example.smartcivicgovernance.ui.citizen.CitizenHomeFragment"
        android:label="Citizen Home"
        tools:layout="@layout/fragment_citizen_home" />

    <fragment
        android:id="@+id/myComplaintsFragment"
        android:name="com.example.smartcivicgovernance.ui.citizen.MyComplaintsFragment"
        android:label="My Complaints"
        tools:layout="@layout/fragment_my_complaints" />

    <fragment
        android:id="@+id/citizenLeaderboardFragment"
        android:name="com.example.smartcivicgovernance.ui.citizen.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/citizenProfileFragment"
        android:name="com.example.smartcivicgovernance.ui.citizen.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Worker Flow -->
    <fragment
        android:id="@+id/workerTasksFragment"
        android:name="com.example.smartcivicgovernance.ui.worker.WorkerTasksFragment"
        android:label="Worker Tasks"
        tools:layout="@layout/fragment_worker_tasks" />

    <fragment
        android:id="@+id/workerStatsFragment"
        android:name="com.example.smartcivicgovernance.ui.worker.WorkerStatsFragment"
        android:label="Worker Stats"
        tools:layout="@layout/fragment_worker_stats" />

    <!-- Admin Flow -->
    <fragment
        android:id="@+id/adminOverviewFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.AdminOverviewFragment"
        android:label="Admin Overview"
        tools:layout="@layout/fragment_admin_overview" />

    <fragment
        android:id="@+id/complaintsManagementFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.ComplaintsManagementFragment"
        android:label="Complaints Management"
        tools:layout="@layout/fragment_complaints_management" />

    <fragment
        android:id="@+id/complaintVerificationFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.ComplaintVerificationFragment"
        android:label="Verification"
        tools:layout="@layout/fragment_complaint_verification" />

    <fragment
        android:id="@+id/userManagementFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.UserManagementFragment"
        android:label="User Management"
        tools:layout="@layout/fragment_user_management" />

    <fragment
        android:id="@+id/workerApprovalFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.WorkerApprovalFragment"
        android:label="Worker Approval"
        tools:layout="@layout/fragment_worker_approval" />

    <fragment
        android:id="@+id/workerAssignmentFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.WorkerAssignmentFragment"
        android:label="Assign Worker"
        tools:layout="@layout/fragment_worker_assignment" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/duplicateDetectionFragment"
        android:name="com.example.smartcivicgovernance.ui.admin.DuplicateDetectionFragment"
        android:label="Duplicate Detection"
        tools:layout="@layout/fragment_duplicate_detection" />
</navigation>
